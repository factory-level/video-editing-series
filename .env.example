# Copy to .env (git-ignored) on each machine and fill in. Nothing here is secret, but the values are
# specific to your machines, so only this example is committed.

# --- Edit server -------------------------------------------------------------------------------
# Where video content lives on the edit server's disk. Each video is one folder:
#   $CONTENT_ROOT/<nnnn-video-slug>/raw/<nn>/     recordings, as uploaded (only ever read)
#   $CONTENT_ROOT/<nnnn-video-slug>/edit/scenes/  cut by first edit
#   $CONTENT_ROOT/<nnnn-video-slug>/edit/final/   finished videos
CONTENT_ROOT=/path/to/content

# --- Laptop: where to upload ----------------------------------------------------------------------
# SSH login for the edit server, and its CONTENT_ROOT as seen on that machine. A recording goes to
#   $EDIT_SERVER_SSH:$EDIT_SERVER_CONTENT_ROOT/<nnnn-video-slug>/raw/<nn>/
# for example: rsync -a --checksum takes/<session>/<take>/ "$EDIT_SERVER_SSH:$EDIT_SERVER_CONTENT_ROOT/0001-my-video/raw/01/"
EDIT_SERVER_SSH=user@edit-server
EDIT_SERVER_CONTENT_ROOT=/path/to/content

# After an upload is verified, the laptop queues the recording for first edit on the server:
#   ssh $EDIT_SERVER_SSH "$EDIT_SERVER_RIG queue create --source upload@external \
#     --destination $FIRST_EDIT_SEAT --summary 'First edit <video> recording <nn>' \
#     --body 'Recording folder: $EDIT_SERVER_CONTENT_ROOT/<video>/raw/<nn>' --verify"
EDIT_SERVER_RIG=~/.local/bin/rig
FIRST_EDIT_SEAT=edit-cut@first-edit

# --- Laptop: stage 1 (direct) ----------------------------------------------------------------------
# direct/launch reads these. The PipeWire source recorded as studio.wav; empty means the default input.
# Set it to record a USB recorder while the computer keeps another microphone as its default.
# List sources with: pactl list short sources
DIRECT_MIC=
# Other stdio MCP servers whose tools join the shim's, separated by ";". Must be set in the environment
# tunnel-client starts from; direct/ctl mcp reads it there.
DIRECT_MCP_STITCH=
