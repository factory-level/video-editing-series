#!/bin/sh
# Stage 1 (laptop): record takes hands-free and cut them into raw narration. See direct/README.md.
#   bin/direct           what stage 1 is and what is built
#   bin/direct doctor    check this machine for what recording needs
# Recording itself (load, roll, cut, prompter, keep, discard, handoff) is specified but not built yet.
root=$(dirname "$(readlink -f "$0")")/..
have() { command -v "$1" >/dev/null 2>&1; }
check() { # check <label> <ok: 0|1> <detail>
  if [ "$2" -eq 0 ]; then printf '  ok       %-12s %s\n' "$1" "$3"; else printf '  missing  %-12s %s\n' "$1" "$3"; missing=1; fi
}
case "${1:-}" in
  ''|-h|--help)
    sed -n '2,5s/^# \{0,1\}//p' "$0"
    echo; echo "Specification: $(readlink -f "$root/direct/README.md")" ;;
  doctor)
    missing=0
    have ffmpeg; check ffmpeg $? "$(ffmpeg -version 2>/dev/null | sed -n '1s/ Copyright.*//p')"
    have git; check git $? "$(git --version 2>/dev/null)"
    if have lsusb; then
      cam=$(lsusb 2>/dev/null | grep -i 'canon' | sed 's/^.*ID [0-9a-f:]* //' | head -1)
      [ -n "$cam" ]; check camera $? "${cam:-no Canon camera on USB (plugged in, switched on, not mounted as storage?)}"
    elif have system_profiler; then
      cam=$(system_profiler SPUSBDataType 2>/dev/null | grep -i 'canon' | head -1 | sed 's/^ *//; s/:$//')
      [ -n "$cam" ]; check camera $? "${cam:-no Canon camera on USB}"
    else
      check camera 1 "cannot list USB devices here (no lsusb or system_profiler)"
    fi
    if have arecord; then
      mic=$(arecord -l 2>/dev/null | grep -c '^card')
      [ "$mic" -gt 0 ]; check microphone $? "$mic capture device(s)"
    elif have system_profiler; then
      mic=$(system_profiler SPAudioDataType 2>/dev/null | grep -c 'Input Channels')
      [ "$mic" -gt 0 ]; check microphone $? "$mic input device(s)"
    else
      check microphone 1 "cannot list audio inputs here (no arecord or system_profiler)"
    fi
    [ "$missing" -eq 0 ] && echo "ready for recording hardware checks" || { echo "not ready: this is the laptop's job, see direct/README.md"; exit 1; } ;;
  load|roll|cut|status|prompter|keep|discard|handoff)
    echo "direct $1 is not built yet; see direct/README.md" >&2; exit 2 ;;
  *) echo "unknown command: $1 (try bin/direct --help)" >&2; exit 2 ;;
esac
