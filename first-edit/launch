#!/bin/sh
# First edit of one take: align camera and studio sound, transcribe, cut every reading into its own
# piece and sort the pieces by idea. Runs on the server. See first-edit/README.md.
#   first-edit/launch <take folder> [--plan] [--pad 0.15] [--gap 0.6] [--model NAME] [--force]
#   first-edit/launch --help
here=$(dirname "$(readlink -f "$0")")
command -v uv >/dev/null 2>&1 || { echo "first-edit needs uv: https://docs.astral.sh/uv/" >&2; exit 1; }
exec uv run --quiet "$here/cut.py" "$@"
